<section id="night" aria-labelledby="night-title" style="background: #F5E9F0">
<div style="max-width: 1100px; margin: 0 auto; padding: 96px 24px; display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center">
<div aria-hidden="true" style="flex: 0 0 auto; width: 96px; height: 96px; border-radius: 999px; background: #E6ECF2; position: relative; overflow: visible; display: flex; align-items: center; justify-content: center"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path><path d="M17 3.5l.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5z"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" style="position: absolute; right: -24px; top: -14px; transform: rotate(10deg); opacity: .55; pointer-events: none; overflow: visible"><path d="M15.10 12.41L20.75 15.73Q22.08 17.12 20.18 16.86L13.53 14.72L11.34 18.10Q10.70 19.61 10.59 17.97L9.60 14.00L2.53 12.71Q0.72 12.10 2.52 11.45L9.46 10.18L7.48 3.00Q7.28 1.08 8.54 2.54L12.88 9.00L18.11 7.54Q19.82 7.07 18.67 8.41L15.10 12.41Z" fill="#8DA4BD" stroke="#8DA4BD" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" style="position: absolute; left: -20px; bottom: 0; transform: rotate(-15deg); opacity: .55; pointer-events: none; overflow: visible"><path d="M13.53 14.72L11.67 21.65Q10.91 23.40 10.50 21.54L10.52 14.75L4.79 17.99Q3.07 18.68 4.22 17.22L9.04 12.99L4.47 13.08Q2.75 12.70 4.40 12.07L9.02 11.08L6.28 7.84Q5.29 6.44 6.85 7.15L10.50 9.26L10.81 2.30Q11.22 0.45 11.88 2.23L13.12 9.09L17.09 4.97Q18.57 3.91 17.85 5.58L14.65 10.36L17.96 12.72Q19.45 13.40 17.82 13.48L14.48 13.89L17.30 16.11Q18.30 17.45 16.84 16.65L13.53 14.72Z" fill="#E1BED4" stroke="#E1BED4" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13" style="position: absolute; right: -6px; bottom: -18px; transform: rotate(5deg); opacity: .55; pointer-events: none; overflow: visible"><path d="M11.51 15.10L8.46 17.06Q7.25 18.14 7.99 16.69L9.04 13.04L4.41 10.55Q2.84 9.81 4.57 9.86L9.72 9.85L8.75 4.16Q8.73 2.32 9.83 3.80L12.57 8.92L17.91 4.83Q19.56 3.91 18.76 5.62L15.00 11.10L21.83 13.60Q23.48 14.63 21.55 14.83L14.24 14.19L16.36 20.49Q16.61 22.35 15.40 20.91L11.51 15.10Z" fill="#8A8350" stroke="#8A8350" stroke-width="1.6" stroke-linejoin="round"></path></svg></div>
<div style="flex: 1 1 480px; min-width: 0">
<p style="margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #4E2B22">{c.night.eyebrow}</p>
<h2 id="night-title" style="margin: 0 0 20px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.015em; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.15; max-width: 720px">{c.night.title}</h2>
<p style="margin: 0; max-width: 640px; font-size: 19px; color: #5A4A42" set:html={inline(c.night.body)} data-tina-field={tf(c.night, 'body')}></p>
</div>
</div>
</section>

<section id="name" aria-labelledby="name-title" style="background: #435B74; color: #FBF5EC">
<div style="max-width: 1100px; margin: 0 auto; padding: 104px 24px; position: relative">
<svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" style="position: absolute; right: 5%; top: 84px; transform: rotate(-8deg); opacity: .4; pointer-events: none; overflow: visible"><path d="M8.58 11.76L5.68 10.51Q4.25 9.64 5.92 9.72L9.65 9.51L10.73 5.22Q10.92 3.54 11.52 5.12L13.52 8.93L18.54 6.36Q20.27 5.74 19.21 7.24L15.41 11.68L21.06 14.81Q22.55 15.97 20.66 15.87L14.34 14.51L13.26 17.95Q13.12 19.58 12.52 18.06L10.99 15.28L4.39 16.77Q2.53 17.06 3.80 15.67L8.58 11.76Z" fill="#FBF5EC" stroke="#FBF5EC" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" style="position: absolute; right: calc(5% + 64px); top: 150px; transform: rotate(14deg); opacity: .45; pointer-events: none; overflow: visible"><path d="M11.95 15.37L10.22 18.12Q9.43 19.55 9.67 17.93L9.44 14.20L2.16 15.07Q0.25 15.08 1.92 14.14L8.75 11.10L5.12 5.61Q4.33 3.88 6.01 4.77L11.10 8.75L14.46 6.43Q15.52 5.18 15.12 6.77L14.77 10.07L18.37 9.93Q20.04 9.85 18.55 10.61L15.20 13.06L17.62 19.89Q18.15 21.70 16.73 20.45L11.95 15.37Z" fill="#E1BED4" stroke="#E1BED4" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" style="position: absolute; right: calc(5% + 10px); top: 200px; transform: rotate(0deg); opacity: .35; pointer-events: none; overflow: visible"><path d="M13.81 9.43L20.31 7.25Q22.12 6.83 20.72 8.06L15.14 12.20L16.80 16.98Q17.64 18.43 16.31 17.41L12.65 15.08L11.44 20.37Q10.86 22.05 10.67 20.28L10.10 14.51L3.52 14.11Q1.70 13.92 3.33 13.09L8.97 11.16L7.25 8.02Q6.29 6.71 7.67 7.57L11.10 8.99L12.16 4.19Q12.75 2.53 13.07 4.26L13.81 9.43Z" fill="#FBF5EC" stroke="#FBF5EC" stroke-width="1.6" stroke-linejoin="round"></path></svg>
<p style="margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FBF5EC">{c.name.eyebrow}</p>
<h2 id="name-title" style="margin: 0 0 24px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.015em; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.1; max-width: 760px; color: #E6D9C9">Why <span style="font-weight: 700">mama</span><span style="font-style: italic; font-weight: 400">says</span></h2>
<p style="margin: 0 0 14px; max-width: 680px; font-size: 20px; color: #FBF5EC">{c.name.body1}</p>
<p style="margin: 0 0 56px; max-width: 680px; font-size: 20px; color: #FBF5EC">{c.name.body2}</p>
<div style="display: flex; flex-wrap: wrap; gap: 48px 72px">
<div style="flex: 1 1 320px; min-width: 0">
<p style="margin: 0 0 18px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FBF5EC">{c.name.saidLabel}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
{c.name.said.map((s, i) => (<li data-tina-field={tf(c.name, 'said', i)} style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: clamp(23px, 2.4vw, 28px); line-height: 1.3; color: #FBF5EC">“{s}”</li>))}
</ul>
</div>
<div style="flex: 1 1 320px; min-width: 0; border-left: 2px solid rgba(251, 245, 236, 0.35); padding-left: 40px">
<p style="margin: 0 0 18px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FBF5EC">{c.name.sayLabel}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
{c.name.say.map((s, i) => (<li style="font-size: clamp(22px, 2.4vw, 28px); line-height: 1.3; color: #FBF5EC"><span style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700">mama</span><span style="font-family: 'Cormorant Garamond', Georgia, serif">says</span> <span style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: 1.15em" data-tina-field={tf(c.name, 'say', i)}>{s}</span></li>))}
</ul>
</div>
</div>
<p style="margin: 72px 0 0; padding-top: 40px; border-top: 2px solid rgba(251, 245, 236, 0.35); font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.015em; font-size: clamp(30px, 3.8vw, 48px); line-height: 1.15; color: #FBF5EC"><span>{c.name.closing1}</span> <span style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: 1.15em">{c.name.closing2}</span></p>
</div>
</section>

<section id="join" aria-labelledby="join-title" style="max-width: 1200px; margin: 0 auto; padding: 112px 24px">
<div style="background: #FFFCF7; border: 1px solid #E6D9C9; border-radius: 8px; position: relative; padding: clamp(32px, 6vw, 72px); display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center">
<svg aria-hidden="true" viewBox="0 0 24 24" width="51" height="51" style="position: absolute; right: -26px; top: -30px; transform: rotate(10deg); opacity: .55; pointer-events: none; overflow: visible"><path d="M11.95 15.37L10.22 18.12Q9.43 19.55 9.67 17.93L9.44 14.20L2.16 15.07Q0.25 15.08 1.92 14.14L8.75 11.10L5.12 5.61Q4.33 3.88 6.01 4.77L11.10 8.75L14.46 6.43Q15.52 5.18 15.12 6.77L14.77 10.07L18.37 9.93Q20.04 9.85 18.55 10.61L15.20 13.06L17.62 19.89Q18.15 21.70 16.73 20.45L11.95 15.37Z" fill="#E1BED4" stroke="#E1BED4" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" style="position: absolute; right: 54px; top: -36px; transform: rotate(-12deg); opacity: .55; pointer-events: none; overflow: visible"><path d="M11.82 8.80L13.85 6.31Q14.77 4.97 14.53 6.58L14.22 9.68L19.24 9.65Q21.00 9.70 19.48 10.59L15.19 12.34L20.08 16.34Q21.33 17.71 19.55 17.21L13.87 14.61L14.24 18.45Q14.30 20.13 13.46 18.66L11.47 15.17L9.06 21.02Q7.85 22.49 7.96 20.59L9.64 14.18L6.25 14.78Q4.60 15.01 5.94 14.01L8.80 11.82L6.08 9.60Q4.75 8.64 6.35 9.02L9.88 9.59L7.50 2.92Q7.34 0.98 8.62 2.44L11.82 8.80Z" fill="#8A8350" stroke="#8A8350" stroke-width="1.6" stroke-linejoin="round"></path></svg>
<div style="flex: 1 1 400px">
<h2 id="join-title" style="margin: 0 0 16px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.015em; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.1">{c.join.title}</h2>
<p style="margin: 0 0 28px; font-size: 19px; color: #1A1714">{c.join.intro}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 17px; font-weight: 600">
<li style="display: flex; align-items: center; gap: 14px"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>{c.join.perks[0]}</li>
<li style="display: flex; align-items: center; gap: 14px" data-tina-field={tf(c.join, 'perks', 1)}><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M5 12v9h14v-9"></path><path d="M12 8v13"></path><path d="M12 8C10.5 4.5 7 4.5 7 6.5S10 8 12 8z"></path><path d="M12 8c1.5-3.5 5-3.5 5-1.5S14 8 12 8z"></path></svg>{c.join.perks[1]}</li>
<li style="display: flex; align-items: center; gap: 14px" data-tina-field={tf(c.join, 'perks', 2)}><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"></path><path d="M18 14a6.5 6.5 0 0 1 3.5 6"></path></svg>{c.join.perks[2]}</li>
</ul>
</div>
<form action="#join" method="get" data-signup-form="join" style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 14px">
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
<label for="join-name" style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase" data-tina-field={tf(c.join, 'nameLabel')}>{c.join.nameLabel}</label>
<input id="join-name" type="text" name="name" autocomplete="given-name" style="min-height: 52px; box-sizing: border-box; padding: 0 20px; border: 1px solid #8C7A6E; border-radius: 6px; background: #FBF5EC; font-family: Figtree, sans-serif; font-size: 16px; color: #1A1714">
<label for="join-email" style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase" data-tina-field={tf(c.join, 'emailLabel')}>{c.join.emailLabel}</label>
<input id="join-email" type="email" name="email" autocomplete="email" required="" placeholder={c.join.emailPlaceholder} style="min-height: 52px; box-sizing: border-box; padding: 0 20px; border: 1px solid #8C7A6E; border-radius: 6px; background: #FBF5EC; font-family: Figtree, sans-serif; font-size: 16px; color: #1A1714">
<button type="submit" style="margin-top: 8px; min-height: 56px; border: 0; border-radius: 999px; background: #4E2B22; color: #FBF5EC; font-family: Figtree, sans-serif; font-size: 15px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px" data-tina-field={tf(c.join, 'button')}>{c.join.button}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBF5EC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
<p style="margin: 0; font-size: 14px; color: #5A4A42">Read our <a href="#privacy">privacy promise</a>.</p>
<p data-signup-status role="status" aria-live="polite" hidden style="margin: 0; flex: 1 1 100%; font-size: 16px; font-weight: 600; color: #4E2B22"></p>
</form>
</div>
</section>

</main>

<footer style="border-top: 1px solid #E6D9C9; background: #FFFCF7">
<div style="max-width: 1200px; margin: 0 auto; padding: 64px 24px 48px; display: flex; flex-wrap: wrap; gap: 40px 64px; font-size: 14px; color: #5A4A42">
<section id="privacy" aria-labelledby="privacy-title" style="flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<h2 id="privacy-title" style="margin: 0 0 4px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; line-height: 1.2; font-weight: 700; color: #1A1714" data-tina-field={tf(c.privacy, 'title')}>{c.privacy.title}</h2>
{c.privacy.paragraphs.map((p, i) => <p style="margin: 0; line-height: 1.6" set:html={inline(p)} data-tina-field={tf(c.privacy, 'paragraphs', i)}></p>)}
</section>
<section id="terms" aria-labelledby="terms-title" style="flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<h2 id="terms-title" style="margin: 0 0 4px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; line-height: 1.2; font-weight: 700; color: #1A1714" data-tina-field={tf(c.terms, 'title')}>{c.terms.title}</h2>
{c.terms.paragraphs.map((p, i) => <p style="margin: 0; line-height: 1.6" set:html={inline(p)} data-tina-field={tf(c.terms, 'paragraphs', i)}></p>)}
</section>
</div>
<div style="max-width: 1200px; margin: 0 auto; padding: 24px 24px 40px; border-top: 1px solid #E6D9C9; display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; font-size: 14px; color: #5A4A42">
<span style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; color: #1A1714"><span style="font-weight: 700">mama</span><span style="font-style: italic">says</span></span>
<div style="display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center">
<a href="#privacy" style="min-height: 44px; display: inline-flex; align-items: center">Privacy</a>
<a href="#terms" style="min-height: 44px; display: inline-flex; align-items: center">Terms</a>
<a href={`mailto:${c.footer.contactEmail}`} style="min-height: 44px; display: inline-flex; align-items: center">Contact</a>
<button type="button" id="motion-toggle" aria-pressed="false" style="min-height: 44px; padding: 0; border: 0; background: none; color: #4E2B22; font-family: Figtree, sans-serif; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; display: inline-flex; align-items: center"><span data-state="playing" data-tina-field={tf(c.footer, 'pauseLabel')}>{c.footer.pauseLabel}</span><span data-state="paused" hidden data-tina-field={tf(c.footer, 'playLabel')}>{c.footer.playLabel}</span></button>
<button type="button" id="consent-reopen" hidden style="min-height: 44px; padding: 0; border: 0; background: none; color: #4E2B22; font-family: Figtree, sans-serif; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; align-items: center" data-tina-field={tf(c.consent, 'manageLabel')}>{c.consent.manageLabel}</button>
<span data-tina-field={tf(c.footer, 'copyright')}>{c.footer.copyright}</span>
</div>
</div>
<svg aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none" style="display: block; width: 100%; height: 48px">
<line x1="0" y1="24" x2="1440" y2="15" stroke={c.palette.bandC} stroke-width="13" vector-effect="non-scaling-stroke"></line>
<line x1="0" y1="33" x2="1440" y2="25" stroke={c.palette.bandD} stroke-width="13" vector-effect="non-scaling-stroke"></line>
</svg>
</footer>

</div>

<div id="consent-banner" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" hidden>
  <h2 id="consent-title" data-tina-field={tf(c.consent, 'title')}>{c.consent.title}</h2>
  <p id="consent-text" data-tina-field={tf(c.consent, 'text')}>{c.consent.text}</p>
  <div class="actions">
    <button type="button" data-choice="granted" data-tina-field={tf(c.consent, 'accept')}>{c.consent.accept}</button>
    <button type="button" data-choice="denied" data-tina-field={tf(c.consent, 'decline')}>{c.consent.decline}</button>
  </div>
</div>
<script>
  import '../scripts/site';
</script>
</body>
</html>
