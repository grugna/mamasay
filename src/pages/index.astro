---
import '../styles/global.css';
import { getSite } from '../lib/content';
import pillLayout from '../lib/pill-layout.json';
import { inline, signature } from '../lib/inline';

const { data: c, tf } = await getSite();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p.replace(/^\/+/, '')}`;
const motionK = ({ calm: 0.5, lively: 0.3, still: 1000 } as Record<string, number>)[c.settings.motion] ?? 0.5;
const t = c.tracking;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.seo.title}</title>
<meta name="description" content={c.seo.description} />
<meta property="og:title" content={c.seo.title} />
<meta property="og:description" content={c.seo.description} />
<meta property="og:image" content={new URL(asset(c.hero.photo.image), Astro.site).href} />
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
<link rel="preload" href={asset('fonts/cormorant-garamond-italic-latin.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href={asset('fonts/fonts.css')} />
</head>
<body
  data-ga-id={t.ga4MeasurementId}
  data-cio-key={t.customerIoWritePublicKey}
  data-cio-region={t.customerIoRegion}
  data-consent-countries={JSON.stringify(t.consentCountries)}
  data-consent-states={JSON.stringify(t.consentUsStates)}
  data-success={c.signup.successMessage}
  data-error={c.signup.errorMessage}
>
<div id="page" class={`motion-${c.settings.motion}`} style={`--k: ${motionK}; background: #FBF5EC; color: #1A1714; font-family: Figtree, system-ui, sans-serif; font-size: 18px; line-height: 1.6; position: relative`}>
<a href="#join" class="skip" data-tina-field={tf(c, 'skipLabel')}>{c.skipLabel}</a>

<svg aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none" style="display: block; width: 100%; height: 48px; position: relative; z-index: 2">
<line x1="0" y1="14" x2="1440" y2="24" stroke={c.palette.bandA} stroke-width="13" vector-effect="non-scaling-stroke"></line>
<line x1="0" y1="24" x2="1440" y2="32" stroke={c.palette.bandB} stroke-width="13" vector-effect="non-scaling-stroke"></line>
</svg>

<main>

<section id="top" style="display: flex; flex-wrap: wrap; min-height: 820px">
<div style="flex: 1 1 560px; min-width: 0; box-sizing: border-box; padding: 24px clamp(24px, 5vw, 80px) 72px; display: flex; flex-direction: column; gap: 56px; position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none"><svg aria-hidden="true" viewBox="0 0 24 24" width="27" height="27" style="position: absolute; left: 3%; top: 30%; transform: rotate(8deg); opacity: .5; pointer-events: none; overflow: visible"><path d="M8.58 11.76L5.68 10.51Q4.25 9.64 5.92 9.72L9.65 9.51L10.73 5.22Q10.92 3.54 11.52 5.12L13.52 8.93L18.54 6.36Q20.27 5.74 19.21 7.24L15.41 11.68L21.06 14.81Q22.55 15.97 20.66 15.87L14.34 14.51L13.26 17.95Q13.12 19.58 12.52 18.06L10.99 15.28L4.39 16.77Q2.53 17.06 3.80 15.67L8.58 11.76Z" fill="#8A8350" stroke="#8A8350" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="27" height="27" style="position: absolute; left: 62%; top: 15%; transform: rotate(-10deg); opacity: .5; pointer-events: none; overflow: visible"><path d="M11.95 15.37L10.22 18.12Q9.43 19.55 9.67 17.93L9.44 14.20L2.16 15.07Q0.25 15.08 1.92 14.14L8.75 11.10L5.12 5.61Q4.33 3.88 6.01 4.77L11.10 8.75L14.46 6.43Q15.52 5.18 15.12 6.77L14.77 10.07L18.37 9.93Q20.04 9.85 18.55 10.61L15.20 13.06L17.62 19.89Q18.15 21.70 16.73 20.45L11.95 15.37Z" fill="#E1BED4" stroke="#E1BED4" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="35" height="35" style="position: absolute; left: 92%; top: 52%; transform: rotate(5deg); opacity: .5; pointer-events: none; overflow: visible"><path d="M13.81 9.43L20.31 7.25Q22.12 6.83 20.72 8.06L15.14 12.20L16.80 16.98Q17.64 18.43 16.31 17.41L12.65 15.08L11.44 20.37Q10.86 22.05 10.67 20.28L10.10 14.51L3.52 14.11Q1.70 13.92 3.33 13.09L8.97 11.16L7.25 8.02Q6.29 6.71 7.67 7.57L11.10 8.99L12.16 4.19Q12.75 2.53 13.07 4.26L13.81 9.43Z" fill="#8A8350" stroke="#8A8350" stroke-width="1.6" stroke-linejoin="round"></path></svg><svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" style="position: absolute; left: 40%; top: 94%; transform: rotate(6deg); opacity: .5; pointer-events: none; overflow: visible"><path d="M9.13 11.25L5.62 7.09Q4.64 5.60 6.25 6.37L11.08 9.18L13.05 4.04Q13.83 2.44 13.97 4.22L13.83 9.66L19.50 8.34Q21.29 8.12 19.88 9.24L14.95 12.33L17.57 16.23Q18.62 17.55 17.13 16.75L12.82 14.85L12.25 18.04Q11.82 19.63 11.47 18.02L10.60 14.61L6.28 14.31Q4.63 14.43 6.03 13.55L9.13 11.25Z" fill="#E1BED4" stroke="#E1BED4" stroke-width="1.6" stroke-linejoin="round"></path></svg></div>
<header style="position: relative; display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between">
<a href="#top" aria-label="mamasays home" style="text-decoration: none; color: #1A1714; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 30px; line-height: 1; letter-spacing: -0.01em"><span style="font-weight: 700">mama</span><span style="font-style: italic; font-weight: 400">says</span></a>
<nav aria-label="Main" style="display: flex; flex-wrap: wrap; gap: 24px; align-items: center">
<a href="#how" style="color: #1A1714; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; min-height: 44px; display: inline-flex; align-items: center" data-tina-field={tf(c.nav, 'how')}>{c.nav.how}</a>
<a href="#memories" style="color: #1A1714; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; min-height: 44px; display: inline-flex; align-items: center" data-tina-field={tf(c.nav, 'memories')}>{c.nav.memories}</a>
<a href="#firsts" style="color: #1A1714; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; min-height: 44px; display: inline-flex; align-items: center" data-tina-field={tf(c.nav, 'firsts')}>{c.nav.firsts}</a>
{c.settings.showStory && (<a href="#story" style="color: #1A1714; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; min-height: 44px; display: inline-flex; align-items: center" data-tina-field={tf(c.nav, 'story')}>{c.nav.story}</a>)}
</nav>
</header>
<div style="position: relative; flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; max-width: 640px">
<p style="margin: 0 0 28px; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 12px; border: 1px solid #E6D9C9; border-radius: 999px; background: #FFFCF7; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #4E2B22" data-tina-field={tf(c.hero, 'badge')}><svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="5" fill="#8A8350"></circle></svg>{c.hero.badge}</p>
<h1 style="margin: 0 0 32px; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: clamp(58px, 7vw, 98px); line-height: 0.98; letter-spacing: -0.015em; color: #1A1714"><span style="display: block; position: relative; width: max-content; max-width: 100%; isolation: isolate"><span aria-hidden="true" style={`position: absolute; z-index: -1; left: -0.14em; right: -0.12em; top: 22%; bottom: 4%; background: ${c.palette.highlight}; opacity: 0.85; clip-path: polygon(0 6%, 2% 0, 4% 8%, 6% 0, 100% 4%, 98% 50%, 100% 96%, 4% 100%, 2% 92%, 0 100%, 1.5% 50%); transform: rotate(-2deg)`}></span><span style="position: relative" data-tina-field={tf(c.hero, 'headline1')}>{c.hero.headline1}</span></span><span style="display: block; position: relative; width: max-content; max-width: 100%; isolation: isolate"><span aria-hidden="true" style={`position: absolute; z-index: -1; left: -0.14em; right: -0.12em; top: 22%; bottom: 4%; background: ${c.palette.highlight}; opacity: 0.85; clip-path: polygon(0 6%, 2% 0, 4% 8%, 6% 0, 100% 4%, 98% 50%, 100% 96%, 4% 100%, 2% 92%, 0 100%, 1.5% 50%); transform: rotate(1.5deg)`}></span><span style="position: relative" data-tina-field={tf(c.hero, 'headline2')}>{c.hero.headline2}</span></span></h1>
<p style="margin: 0 0 36px; font-size: clamp(21px, 2vw, 24px); line-height: 1.45; font-weight: 500; color: #1A1714; max-width: 540px" data-tina-field={tf(c.hero, 'lead')}>{c.hero.lead}</p>
<p style="margin: -20px 0 36px; font-size: 18px; line-height: 1.5; color: #1A1714; max-width: 520px" data-tina-field={tf(c.hero, 'sub')}>{c.hero.sub}</p>
<form action="#join" method="get" data-signup-form="hero" style="display: flex; flex-wrap: wrap; gap: 12px; max-width: 540px">
<label for="hero-email" class="sr-only">Email address</label>
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
<input id="hero-email" type="email" name="email" autocomplete="email" required="" placeholder={c.hero.emailPlaceholder} style="flex: 1 1 240px; min-height: 52px; box-sizing: border-box; padding: 0 20px; border: 1px solid #8C7A6E; border-radius: 999px; background: #FFFCF7; font-family: Figtree, sans-serif; font-size: 16px; color: #1A1714">
<button type="submit" style="flex: 0 0 auto; min-height: 52px; padding: 0 28px; border: 0; border-radius: 999px; background: #4E2B22; color: #FBF5EC; font-family: Figtree, sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; display: inline-flex; align-items: center; gap: 10px" data-tina-field={tf(c.hero, 'button')}>{c.hero.button}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBF5EC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
<p data-signup-status role="status" aria-live="polite" hidden style="margin: 0; flex: 1 1 100%; font-size: 16px; font-weight: 600; color: #4E2B22"></p>
</form>
<ul style="margin: 20px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14px; font-weight: 600; color: #5A4A42">
<li style="display: inline-flex; align-items: center; gap: 8px" data-tina-field={tf(c.hero, 'perks', 0)}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>{c.hero.perks[0]}</li>
<li style="display: inline-flex; align-items: center; gap: 8px" data-tina-field={tf(c.hero, 'perks', 1)}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>{c.hero.perks[1]}</li>
<li style="display: inline-flex; align-items: center; gap: 8px" data-tina-field={tf(c.hero, 'perks', 2)}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>{c.hero.perks[2]}</li>
</ul>
</div>
</div>

<div style="flex: 1 1 480px; min-width: 0; min-height: 560px; margin-top: -30px; position: relative; z-index: 1; background: #E6ECF2">
<img src={asset(c.hero.photo.image)} data-tina-field={tf(c.hero.photo, 'image')} alt={c.hero.photo.alt} style="position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 40% center">
<aside aria-label="Example of a day in mamasays" style="position: absolute; left: clamp(16px, 3vw, 40px); right: clamp(16px, 3vw, 40px); bottom: clamp(16px, 3vw, 40px); max-width: 360px; box-sizing: border-box; background: #FFFCF7; border-radius: 4px; padding: 20px 22px; box-shadow: 0 12px 32px rgba(78, 43, 34, 0.18)">
<p style="margin: 0 0 14px; font-family: Marcellus, Georgia, serif; font-size: 16px; letter-spacing: 0.08em; text-transform: uppercase; color: #1A1714" data-tina-field={tf(c.today, 'title')}>{c.today.title}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
<li style="display: flex; gap: 12px; align-items: flex-start; border-bottom: 1px solid #E6D9C9; padding-bottom: 12px">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex: 0 0 auto; margin-top: 2px"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="M4.9 4.9l1.4 1.4"></path><path d="M17.7 17.7l1.4 1.4"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="M4.9 19.1l1.4-1.4"></path><path d="M17.7 6.3l1.4-1.4"></path></svg>
<div style="min-width: 0">
<p style="margin: 0 0 2px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #5A4A42" data-tina-field={tf(c.today, 'morningLabel')}>{c.today.morningLabel}</p>
<p style="margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: 21px; line-height: 1.25; color: #1A1714" data-tina-field={tf(c.today, 'morningText')}>{c.today.morningText}</p>
</div>
</li>
<li style="display: flex; gap: 12px; align-items: flex-start; border-bottom: 1px solid #E6D9C9; padding-bottom: 12px">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex: 0 0 auto; margin-top: 2px"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
<div style="min-width: 0">
<p style="margin: 0 0 2px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #5A4A42" data-tina-field={tf(c.today, 'eveningLabel')}>{c.today.eveningLabel}</p>
<p style="margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: 21px; line-height: 1.25; color: #1A1714" data-tina-field={tf(c.today, 'eveningText')}>{c.today.eveningText}</p>
</div>
</li>
<li style="display: flex; gap: 12px; align-items: flex-start">
<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4E2B22" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex: 0 0 auto; margin-top: 2px"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.6L12 15l-1.8-4.4L5.5 9l4.7-1.4z"></path><path d="M18.5 15.5l.8 2 2 .7-2 .8-.8 2-.7-2-2-.8 2-.7z"></path></svg>
<div style="min-width: 0">
<p style="margin: 0 0 2px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #5A4A42" data-tina-field={tf(c.today, 'memoryLabel')}>{c.today.memoryLabel}</p>
<p style="margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 600; font-size: 21px; line-height: 1.25; color: #1A1714" data-tina-field={tf(c.today, 'memoryText')}>{c.today.memoryText}</p>
</div>
</li>
</ul>
</aside>
</div>
</section>

<section id="how" style="background: #4E2B22; color: #F2E6D3">
<div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; gap: 48px 80px; align-items: flex-start">
<div style="flex: 1 1 320px; min-width: 0">
<p style="margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #F2E6D3" data-tina-field={tf(c.how, 'eyebrow')}>{c.how.eyebrow}</p>
<h2 style="margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.015em; font-size: clamp(34px, 4.5vw, 54px); line-height: 1.1; color: #F2E6D3" data-tina-field={tf(c.how, 'title')}>{c.how.title}</h2>
</div>
<ol style="flex: 1.6 1 480px; min-width: 0; margin: 0; padding: 0; list-style: none">
<li class="step" style="animation-delay: 0.0s; position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 24px; padding-bottom: 40px">
<div aria-hidden="true" style="position: absolute; left: 27px; top: 64px; bottom: 0; width: 2px; background: rgba(242, 230, 211, 0.3); overflow: hidden"><div class="step-fill" style="animation-delay: 0.0s; width: 100%; height: 100%; background: #F2E6D3"></div></div>
<div aria-hidden="true" style="width: 56px; height: 56px; box-sizing: border-box; border: 2px solid #F2E6D3; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #F2E6D3">1</div>
<div style="min-width: 0; padding-top: 10px">
<h3 style="margin: 0 0 10px; display: flex; align-items: center; gap: 12px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; font-size: 26px; line-height: 1.2; color: #F2E6D3" data-tina-field={tf(c.how.steps[0], 'title')}><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F2E6D3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-9"></path><path d="M12 12c0-4.4 3-7 7.5-7 0 4.4-3 7-7.5 7z"></path><path d="M12 14.5C12 11 9.6 8.5 5 8.5c0 3.5 2.4 6 7 6z"></path></svg>{c.how.steps[0].title}</h3>
<p style="margin: 0; max-width: 560px; color: #F2E6D3" data-tina-field={tf(c.how.steps[0], 'text')}>{c.how.steps[0].text}</p>
</div>
</li>
<li class="step" style="animation-delay: 0.5s; position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 24px; padding-bottom: 40px">
<div aria-hidden="true" style="position: absolute; left: 27px; top: 64px; bottom: 0; width: 2px; background: rgba(242, 230, 211, 0.3); overflow: hidden"><div class="step-fill" style="animation-delay: 0.5s; width: 100%; height: 100%; background: #F2E6D3"></div></div>
<div aria-hidden="true" style="width: 56px; height: 56px; box-sizing: border-box; border: 2px solid #F2E6D3; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #F2E6D3">2</div>
<div style="min-width: 0; padding-top: 10px">
<h3 style="margin: 0 0 10px; display: flex; align-items: center; gap: 12px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; font-size: 26px; line-height: 1.2; color: #F2E6D3" data-tina-field={tf(c.how.steps[1], 'title')}><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F2E6D3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18h18"></path><path d="M7 18a5 5 0 0 1 10 0"></path><path d="M12 6v3"></path><path d="M5.6 10.6l1.6 1.6"></path><path d="M18.4 10.6l-1.6 1.6"></path><path d="M6 21h12"></path></svg>{c.how.steps[1].title}</h3>
<p style="margin: 0; max-width: 560px; color: #F2E6D3" data-tina-field={tf(c.how.steps[1], 'text')}>{c.how.steps[1].text}</p>
</div>
</li>
<li class="step" style="animation-delay: 1.0s; position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 24px; padding-bottom: 0px">
<div aria-hidden="true" style="width: 56px; height: 56px; box-sizing: border-box; border: 2px solid #F2E6D3; border-radius: 999px; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #F2E6D3">3</div>
<div style="min-width: 0; padding-top: 10px">
<h3 style="margin: 0 0 10px; display: flex; align-items: center; gap: 12px; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; font-size: 26px; line-height: 1.2; color: #F2E6D3" data-tina-field={tf(c.how.steps[2], 'title')}><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F2E6D3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"></path><path d="M15 7h6v6"></path></svg>{c.how.steps[2].title}</h3>
<p style="margin: 0; max-width: 560px; color: #F2E6D3" data-tina-field={tf(c.how.steps[2], 'text')}>{c.how.steps[2].text}</p>
</div>
</li>
</ol>
</div>
</section>

<section id="memories" aria-labelledby="memories-title" style="background: #F5E9F0">
