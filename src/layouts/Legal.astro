---
import '../styles/global.css';
import { getEntry, render } from 'astro:content';
import { getSite, trackingAttrs } from '../lib/content';
import ConsentBanner from '../components/ConsentBanner.astro';

const { slug } = Astro.props as { slug: 'privacy' | 'terms' };
const entry = (await getEntry('legal', slug))!;
const { Content } = await render(entry);
const { title, effective, lastUpdated, draft } = entry.data;
const { data: c, tf } = await getSite();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p.replace(/^\/+/, '')}`;
const pageTitle = `${title} · mamasays`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={`${title} for mamasays.`} />
{draft && <meta name="robots" content="noindex" />}
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
<link rel="preload" href={asset('fonts/cormorant-garamond-italic-latin.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href={asset('fonts/fonts.css')} />
</head>
<body {...trackingAttrs(c.tracking)}>
<div id="page" style="background: #FBF5EC; color: #1A1714; font-family: Figtree, system-ui, sans-serif; font-size: 18px; line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column">

<svg aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none" style="display: block; width: 100%; height: 48px">
<line x1="0" y1="14" x2="1440" y2="24" stroke={c.palette.bandA} stroke-width="13" vector-effect="non-scaling-stroke"></line>
<line x1="0" y1="24" x2="1440" y2="32" stroke={c.palette.bandB} stroke-width="13" vector-effect="non-scaling-stroke"></line>
</svg>

<header style="max-width: 760px; width: 100%; box-sizing: border-box; margin: 0 auto; padding: 24px 24px 0">
<a href={`${base}/`} aria-label="mamasays home" style="text-decoration: none; color: #1A1714; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 30px; line-height: 1; letter-spacing: -0.01em"><span style="font-weight: 700">mama</span><span style="font-style: italic; font-weight: 400">says</span></a>
</header>

<main class="legal" style="flex: 1 0 auto; max-width: 760px; width: 100%; box-sizing: border-box; margin: 0 auto; padding: 40px 24px 96px">
{draft && <p class="draft">DRAFT for legal review · not for publication</p>}
<h1>{title}</h1>
<p class="meta">{effective && <>Effective {effective} · </>}Last updated {lastUpdated}</p>
<Content />
</main>

<footer style="border-top: 1px solid #E6D9C9; background: #FFFCF7">
<div style="max-width: 1200px; margin: 0 auto; padding: 24px 24px 40px; display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; font-size: 14px; color: #5A4A42">
<a href={`${base}/`} aria-label="mamasays home" style="text-decoration: none; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; color: #1A1714"><span style="font-weight: 700">mama</span><span style="font-style: italic">says</span></a>
<div style="display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center">
<a href={`${base}/privacy`} style="min-height: 44px; display: inline-flex; align-items: center">Privacy</a>
<a href={`${base}/terms`} style="min-height: 44px; display: inline-flex; align-items: center">Terms</a>
<a href={`mailto:${c.footer.contactEmail}`} style="min-height: 44px; display: inline-flex; align-items: center">Contact</a>
<button type="button" id="consent-reopen" hidden style="min-height: 44px; padding: 0; border: 0; background: none; color: #4E2B22; font-family: Figtree, sans-serif; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; align-items: center" data-tina-field={tf(c.consent, 'manageLabel')}>{c.consent.manageLabel}</button>
<span>{c.footer.copyright}</span>
</div>
</div>
<svg aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none" style="display: block; width: 100%; height: 48px">
<line x1="0" y1="24" x2="1440" y2="15" stroke={c.palette.bandC} stroke-width="13" vector-effect="non-scaling-stroke"></line>
<line x1="0" y1="33" x2="1440" y2="25" stroke={c.palette.bandD} stroke-width="13" vector-effect="non-scaling-stroke"></line>
</svg>
</footer>

</div>

<ConsentBanner consent={c.consent} tf={tf} />
<script>
  import '../scripts/site';
</script>
</body>
</html>

<style is:global>
.legal h1{margin:0 0 8px;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:600;font-size:clamp(40px,6vw,60px);line-height:1.05;letter-spacing:-0.015em}
.legal .meta{margin:0 0 32px;font-size:14px;color:#5A4A42}
.legal .draft{margin:0 0 20px;display:inline-block;padding:6px 14px;border:1px solid #E6D9C9;border-radius:999px;background:#FFFCF7;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#4E2B22}
.legal h2{margin:48px 0 12px;font-family:'Cormorant Garamond',Georgia,serif;font-size:28px;line-height:1.2;font-weight:700}
.legal h3{margin:28px 0 8px;font-family:'Cormorant Garamond',Georgia,serif;font-size:21px;line-height:1.2;font-weight:700}
.legal p,.legal ul,.legal ol{margin:0 0 16px;font-size:17px}
.legal ul,.legal ol{padding-left:1.4em}
.legal li{margin:0 0 8px}
.legal .table-wrap,.legal table{font-size:15px}
.legal table{width:100%;border-collapse:collapse;margin:0 0 24px;display:block;overflow-x:auto}
.legal th,.legal td{padding:10px 12px;border:1px solid #E6D9C9;text-align:left;vertical-align:top}
.legal th{background:#FFFCF7;font-weight:700}
</style>
